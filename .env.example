# Copy to .env for local development:  cp .env.example .env
# On the real server, set these in the host's settings instead. Never commit .env.

DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
SCHOOL_NAME=Our School
TIME_ZONE=America/Chicago
SITE_URL=http://localhost:8000
# ALLOWED_HOSTS=servicehours.yourschool.org
# CSRF_TRUSTED_ORIGINS=https://servicehours.yourschool.org
# DATABASE_URL=postgres://user:password@host:5432/servicehours   (SQLite is used if unset)

# School rules
SCHOOL_YEAR_START_MONTH=7
MAX_HOURS_PER_DAY=12
BLOCKED_SUPERVISOR_DOMAINS=students.yourschool.org
TEACHER_EMAILS=
ADMIN_EMAILS=
APPROVAL_LINK_DAYS=14
REMINDER_AFTER_DAYS=4,9
STALE_PENDING_DAYS=7

# Microsoft Entra ID app registration (from district IT)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Email: "console" prints emails in the terminal; "graph" sends with Microsoft Graph
EMAIL_PROVIDER=console
DEFAULT_FROM_EMAIL=servicehours@yourschool.org
GRAPH_SENDER_MAILBOX=servicehours@yourschool.org

# Test sign-in page (only works when DEBUG=true)
DEV_LOGIN_ENABLED=true
